{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "types": ["node"],
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src"]
}
