# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
# Reference: https://learn.microsoft.com/windows/python/beginners

##########################################################################################################
# This configuration will install the tools necessary to get started with Python development on Windows  #
#                                                                                                        #
# This will:                                                                                             #
#     * Install NodeJS
#     * Install Python                                                                                   #
#     * Install Visual Studio Code                                                                       #
#     * Install Visual Studio Code extension for Python                                                  #
#                                                                                                        #
##########################################################################################################

properties:
  resources:
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Node.js
      directives:
        description: Install Node.js (LTS)
      settings:
        id: OpenJS.NodeJS.LTS
        source: winget
        scope: user
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Python 3.13
      directives:
        description: Install Python 3.13
      settings:
        id: 9PNRBTZXMB4Z
        source: msstore
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Python 3.12
      directives:
        description: Install Python 3.12
      settings:
        id: 9NCVDN91XZQP
        source: msstore
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Python 3.11
      directives:
        description: Install Python 3.11
      settings:
        id: 9NRWMJP3717K
        source: msstore
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: VisualStudio Code
      directives:
        description: Install Visual Studio Code
      settings:
        id: Microsoft.VisualStudioCode
        source: winget
    - resource: Microsoft.VSCode.Dsc/VSCodeExtension
      id: ms-python.python
      dependsOn:
        - VisualStudio Code
      directives:
        description: Install Python Visual Studio Code extension
        allowPrerelease: true
      settings:
        name: ms-python.python
        exist: true
    - resource: Microsoft.VSCode.Dsc/VSCodeExtension
      id: redhat.vscode-yaml
      dependsOn:
        - VisualStudio Code
      directives:
        description: Install YAML Visual Studio Code extension
        allowPrerelease: true
      settings:
        name: redhat.vscode-yaml
        exist: true
    - resource: Microsoft.VSCode.Dsc/VSCodeExtension
      id: vscodevim.vim
      dependsOn:
        - VisualStudio Code
      directives:
        description: Install Vim Visual Studio Code extension
        allowPrerelease: true
      settings:
        name: vscodevim.vim
        exist: true
  configurationVersion: 0.2.0