general {
	output_format = "i3bar"
	colors = true
	interval = 10
}

order += "volume master"
order += "battery 0"
order += "cpu_usage"
order += "memory"
order += "tztime local"

volume master {
	format = "VOL: %volume"
	format_muted = "VOL: muted (%volume)"
	device = "default"
	mixer = "Master"
	mixer_idx = 0
}

battery 0 {
	format = "%status %percentage"
	status_chr = "CHR:"
	status_bat = "BAT:"
	path = "/sys/class/power_supply/BAT%d/uevent"
	low_threshold = 20
}

tztime local {
	format = "%Y-%m-%d %H:%M"
}


cpu_usage {
	format = "CPU: %usage"
}

memory {
	format = "MEM: %used"
	decimals = 2
	format_degraded = "LOW: %free"
}
